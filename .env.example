# Copy to .env (git-ignored) to override the local-dev defaults baked into
# docker-compose.yml. Not required to just get things running.

MYSQL_ROOT_PASSWORD=hft_dev_root
MYSQL_DATABASE=hft_market_intelligence
MYSQL_APP_USER=hft_app
MYSQL_APP_PASSWORD=hft_dev_password

CLICKHOUSE_DATABASE=hft_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=hft_dev_clickhouse

REDIS_PASSWORD=hft_dev_redis
